  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run format:check && npm run typecheck",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,ts,mjs,md}\" \"content/**/*.{md,yml}\" \"public/admin/**/*.{html,yml}\"",
