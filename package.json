    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "next": "^15.5.0",
